# Development Environment Configuration
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_TITLE=Document API (Development)
API_VERSION=1.0.0-dev
API_DESCRIPTION=Development API for document management

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# CORS Configuration (allow frontend dev server)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3001"]

# Database Configuration
DATABASE_URL=sqlite:///./dev_documents.db

# File Storage Configuration
DATA_DIRECTORY=data
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=[".pdf", ".doc", ".docx", ".txt", ".md", ".jpg", ".png"]

# Logging Configuration
LOG_LEVEL=DEBUG

# Security Configuration (development only - not secure)
SECRET_KEY=dev-secret-key-not-for-production

ANTHROPIC_API_KEY="<Your Key here>"